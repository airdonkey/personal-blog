{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $pages = first 20 $pages.ByDate.Reverse -}}
{{- $siteTitle := partial "identity.html" "site_title" -}}
{{- $introduction := partial "identity.html" "introduction" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $siteTitle | transform.XMLEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ $introduction | transform.XMLEscape }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with site.Home.OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title | transform.XMLEscape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
